// Repo scanner: walk a tree and report exact token cost per file.
//
// This is the layer that used to live in token-optimizer-cli's Go scanner. It
// needs to know what a directory entry IS, which MFL could not express until
// stat/is_dir/file_size/is_symlink landed (machin #541) -- porting this is what
// surfaced that gap.
//
// Every exclusion is COUNTED and reported. A scanner that silently drops files
// reads as "I measured everything" when it did not.

var sc_paths = []string{}
var sc_tokens = []int{}
var sc_generated = []int{}
var sc_bytes = 0
var sc_skip_dir = 0
var sc_skip_binary = 0
var sc_skip_large = 0
var sc_skip_link = 0
var sc_skip_dot = 0

var SC_MAX_BYTES = 10485760

func sc_skipdir(name) (yes) {
    yes = name == ".git" || name == "node_modules" || name == ".next" || name == "dist" || name == "build" || name == "target" || name == "__pycache__" || name == ".cache" || name == ".venv" || name == "venv" || name == "vendor" || name == ".pytest_cache"
}

// Lowercased extension including the dot, or "" when there is none.
func sc_ext(path) (e) {
    e = ""
    i := len(path) - 1
    for i >= 0 {
        c := substr(path, i, i+1)
        if c == "/" {
            return e
        }
        if c == "." {
            e = to_lower(substr(path, i, len(path)))
            return e
        }
        i = i - 1
    }
}

func sc_binary(ext) (yes) {
    yes = ext == ".png" || ext == ".jpg" || ext == ".jpeg" || ext == ".gif" || ext == ".ico" || ext == ".svg" || ext == ".woff" || ext == ".woff2" || ext == ".ttf" || ext == ".eot" || ext == ".pdf" || ext == ".zip" || ext == ".tar" || ext == ".gz" || ext == ".bz2" || ext == ".7z" || ext == ".exe" || ext == ".bin" || ext == ".dll" || ext == ".so" || ext == ".dylib" || ext == ".o" || ext == ".a" || ext == ".class" || ext == ".pyc" || ext == ".pyo" || ext == ".mp3" || ext == ".mp4" || ext == ".mov" || ext == ".avi" || ext == ".webm" || ext == ".tiktoken" || ext == ".fixture"
}

var sc_lang = make(map[string]string)

func sc_lang_init() {
    sc_lang[".go"] = "Go"
    sc_lang[".py"] = "Python"
    sc_lang[".js"] = "JavaScript"
    sc_lang[".ts"] = "TypeScript"
    sc_lang[".tsx"] = "TypeScript"
    sc_lang[".jsx"] = "JavaScript"
    sc_lang[".rs"] = "Rust"
    sc_lang[".rb"] = "Ruby"
    sc_lang[".java"] = "Java"
    sc_lang[".c"] = "C"
    sc_lang[".h"] = "C"
    sc_lang[".cpp"] = "C++"
    sc_lang[".cs"] = "C#"
    sc_lang[".php"] = "PHP"
    sc_lang[".sh"] = "Shell"
    sc_lang[".md"] = "Markdown"
    sc_lang[".yml"] = "YAML"
    sc_lang[".yaml"] = "YAML"
    sc_lang[".json"] = "JSON"
    sc_lang[".toml"] = "TOML"
    sc_lang[".xml"] = "XML"
    sc_lang[".html"] = "HTML"
    sc_lang[".css"] = "CSS"
    sc_lang[".sql"] = "SQL"
    sc_lang[".src"] = "MFL"
    sc_lang[".mfl"] = "MFL"
}

func sc_language(path) (l) {
    e := sc_ext(path)
    l = "Unknown"
    if has(sc_lang, e) {
        l = sc_lang[e]
    }
}

// Recursive walk. `depth` bounds pathological trees; symlinks are never
// followed, which is what makes this terminate (a link back up the tree would
// otherwise loop forever -- is_dir() alone cannot tell you, since stat follows).
func sc_walk(dir, depth) {
    if depth > 64 {
        return
    }
    entries := list_dir(dir)
    i := 0
    for i < len(entries) {
        name := entries[i]
        path := dir + "/" + name
        if is_symlink(path) {
            sc_skip_link = sc_skip_link + 1
        } else {
            if is_dir(path) {
                // Dot-DIRECTORIES, not just dotfiles. Missing this let the walk
                // descend into .claude/worktrees/, which holds whole copies of
                // the repo -- a differential run against the Go scanner (which
                // excludes any dot-prefixed path) is what exposed it.
                if sc_skipdir(name) || substr(name, 0, 1) == "." {
                    sc_skip_dir = sc_skip_dir + 1
                } else {
                    sc_walk(path, depth+1)
                }
            } else {
                sc_file(path, name)
            }
        }
        i = i + 1
    }
}

func sc_file(path, name) {
    if substr(name, 0, 1) == "." {
        sc_skip_dot = sc_skip_dot + 1
        return
    }
    ext := sc_ext(path)
    if sc_binary(ext) {
        sc_skip_binary = sc_skip_binary + 1
        return
    }
    sz := file_size(path)
    if sz < 0 {
        sc_skip_binary = sc_skip_binary + 1
        return
    }
    if sz > SC_MAX_BYTES {
        sc_skip_large = sc_skip_large + 1
        return
    }
    data := read_file_bytes(path)
    // Extension lists miss extensionless binaries -- a compiled executable
    // sitting in the repo root tokenizes to millions of junk tokens and
    // dominates every total. The Go original special-cased its own binary by
    // NAME, which only ever protects against itself. A NUL byte in the head of
    // the file is the standard content test (git uses it) and is general.
    probe := len(data)
    if probe > 8000 {
        probe = 8000
    }
    b := 0
    for b < probe {
        if byte_at(data, b) == 0 {
            sc_skip_binary = sc_skip_binary + 1
            return
        }
        b = b + 1
    }
    ids := encode_text(data)
    sc_paths = append(sc_paths, path)
    sc_tokens = append(sc_tokens, len(ids))
    sc_bytes = sc_bytes + len(data)
    gen := 0
    // Only the file HEADER. Scanning the whole head-8KB flagged the Go
    // scanner's own source, because it CONTAINS the marker list a detector
    // greps for -- a generated-code detector matching its own pattern table.
    hn := len(data)
    if hn > 400 {
        hn = 400
    }
    head := bytes_str(bytes_sub(data, 0, hn))
    if contains(head, "DO NOT EDIT") || contains(head, "do not edit") || contains(head, "@generated") || contains(head, "auto-generated") || contains(head, "autogenerated") || contains(head, "GENERATED by") {
        gen = 1
    }
    sc_generated = append(sc_generated, gen)
}

func json_str(s) (out) {
    out = json(s)
}

// Top-N by token count. Partial selection: O(N*files), not a full sort -- N is
// 20 and a big repo has thousands of files.
func sc_top(n) (rows) {
    rows = []string{}
    used := make(map[string]int)
    k := 0
    for k < n {
        best := -1
        bi := -1
        j := 0
        for j < len(sc_tokens) {
            if !has(used, str(j)) {
                if sc_tokens[j] > best {
                    best = sc_tokens[j]
                    bi = j
                }
            }
            j = j + 1
        }
        if bi < 0 {
            return rows
        }
        used[str(bi)] = 1
        rows = append(rows, "{\"path\":" + json_str(sc_paths[bi]) + ",\"tokens\":" + str(sc_tokens[bi]) + ",\"lang\":" + json_str(sc_language(sc_paths[bi])) + "}")
        k = k + 1
    }
}

// Human rendering. The Go original had three verbs -- scan / audit / summary --
// over ONE identical computation, differing only in printer. That is one scan
// and one --human flag.
func sc_human(root, total, bloat_files, bloat_tokens, small, med, large, xl, gen_files, gen_tokens, scan_ms) {
    println("Token Scan — " + root)
    println("=========================================")
    println("Files:        " + str(len(sc_paths)))
    println("Total tokens: " + str(total) + "   (exact BPE, not an estimate)")
    cents := total / 1000
    frac := "" + str(cents % 100)
    if cents % 100 < 10 {
        frac = "0" + str(cents % 100)
    }
    println("Cost:         $" + str(cents / 100) + "." + frac + " per full load at GPT-4o input rates")
    println("Scanned in:   " + str(scan_ms) + " ms")
    println("")
    println("Size distribution:")
    println("  <500 tokens      " + str(small))
    println("  500-1000         " + str(med))
    println("  1000-5000        " + str(large))
    println("  >5000            " + str(xl))
    println("")
    println("Excluded (counted, never silent):")
    println("  vendor dirs " + str(sc_skip_dir) + "   binary " + str(sc_skip_binary) + "   >10MB " + str(sc_skip_large) + "   symlinks " + str(sc_skip_link) + "   dotfiles " + str(sc_skip_dot))
    println("")
    println("Heaviest files:")
    k := 0
    idx := sc_order(20)
    for k < len(idx) {
        j := idx[k]
        mark := ""
        if sc_generated[j] == 1 {
            mark = "   [generated — exclude it]"
        }
        println("  " + str(sc_tokens[j]) + "\t" + sc_language(sc_paths[j]) + "\t" + sc_paths[j] + mark)
        k = k + 1
    }
    println("")
    if gen_files > 0 {
        println("Generated files: " + str(gen_files) + " (" + str(gen_tokens) + " tokens). Not loading them is the")
        println("only change that saves their full cost — splitting or reflowing saves nothing.")
    }
    println("The lever is exclusion. These numbers are what each file costs EVERY time")
    println("it is read whole into a context.")
}

// Indices of the top n files by token count.
func sc_order(n) (idx) {
    idx = []int{}
    used := make(map[string]int)
    k := 0
    for k < n {
        best := -1
        bi := -1
        j := 0
        for j < len(sc_tokens) {
            if !has(used, str(j)) {
                if sc_tokens[j] > best {
                    best = sc_tokens[j]
                    bi = j
                }
            }
            j = j + 1
        }
        if bi < 0 {
            return idx
        }
        used[str(bi)] = 1
        idx = append(idx, bi)
        k = k + 1
    }
}

func run_scan(root, vocab, load_ms, human) {
    sc_lang_init()
    t0 := now_ms()
    if !is_dir(root) {
        println("error: not a directory: " + root)
        exit(2)
    }
    sc_walk(root, 0)
    scan_ms := now_ms() - t0

    total := 0
    bloat_files := 0
    bloat_tokens := 0
    small := 0
    med := 0
    large := 0
    xl := 0
    gen_files := 0
    gen_tokens := 0
    i := 0
    for i < len(sc_tokens) {
        t := sc_tokens[i]
        total = total + t
        if t > 1000 {
            bloat_files = bloat_files + 1
            bloat_tokens = bloat_tokens + t
        }
        if t < 500 { small = small + 1 }
        if t >= 500 && t < 1000 { med = med + 1 }
        if t >= 1000 && t < 5000 { large = large + 1 }
        if t >= 5000 { xl = xl + 1 }
        if sc_generated[i] == 1 {
            gen_files = gen_files + 1
            gen_tokens = gen_tokens + t
        }
        i = i + 1
    }

    if human {
        sc_human(root, total, bloat_files, bloat_tokens, small, med, large, xl, gen_files, gen_tokens, scan_ms)
        return
    }

    skipped := "{\"vendor_dirs\":" + str(sc_skip_dir) + ",\"binary\":" + str(sc_skip_binary) + ",\"over_10mb\":" + str(sc_skip_large) + ",\"symlinks\":" + str(sc_skip_link) + ",\"dotfiles\":" + str(sc_skip_dot) + "}"
    dist := "{\"small\":" + str(small) + ",\"medium\":" + str(med) + ",\"large\":" + str(large) + ",\"xl\":" + str(xl) + "}"
    generated := "{\"files\":" + str(gen_files) + ",\"tokens\":" + str(gen_tokens) + "}"

    println("{\"vocab\":\"" + vocab + "\",\"root\":" + json_str(root) + ",\"files\":" + str(len(sc_paths)) + ",\"tokens\":" + str(total) + ",\"bytes\":" + str(sc_bytes) + ",\"bloat_files\":" + str(bloat_files) + ",\"bloat_tokens\":" + str(bloat_tokens) + ",\"distribution\":" + dist + ",\"generated\":" + generated + ",\"skipped\":" + skipped + ",\"load_ms\":" + str(load_ms) + ",\"scan_ms\":" + str(scan_ms) + ",\"top\":[" + join(sc_top(20), ",") + "]}")
}
